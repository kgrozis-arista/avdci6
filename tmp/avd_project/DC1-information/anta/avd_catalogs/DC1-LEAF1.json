  "anta.tests.connectivity": [
    {
      "VerifyLLDPNeighbors": {
        "result_overwrite": {
          "custom_field": "Generated by AVD"
        },
        "filters": {
          "tags": [
            "DC1-LEAF1"
          ]
        },
        "neighbors": [
          {
            "port": "Ethernet1",
            "neighbor_device": "DC1-SPINE1",
            "neighbor_port": "Ethernet1"
          },
          {
            "port": "Ethernet2",
            "neighbor_device": "DC1-SPINE2",
            "neighbor_port": "Ethernet1"
          }
        ],
        "require_fqdn": false
      }
    },
    {
      "VerifyReachability": {
        "result_overwrite": {
          "description": "Verifies point-to-point reachability between Ethernet interfaces.",
          "custom_field": "Generated by AVD"
        },
        "filters": {
          "tags": [
            "DC1-LEAF1"
          ]
        },
        "hosts": [
          {
            "destination": "10.20.0.0",
            "source": "10.20.0.1",
            "description": "DC1-SPINE1_Ethernet1",
            "vrf": "default",
            "repeat": 1
          },
          {
            "destination": "10.20.0.2",
            "source": "10.20.0.3",
            "description": "DC1-SPINE2_Ethernet1",
            "vrf": "default",
            "repeat": 1
          }
        ]
      }
    }
  ],
